[Unit]
Description=Sahakar Edge Server — Offline Cooperative Training & Sync Daemon
Documentation=https://github.com/ncct/sahakar-edge
After=network.target local-fs.target

[Service]
Type=simple
User=sahakar
Group=sahakar
WorkingDirectory=/opt/sahakar-edge
EnvironmentFile=/etc/sahakar/edge.env
ExecStart=/usr/bin/node /opt/sahakar-edge/apps/edge-server/dist/server.js
Restart=always
RestartSec=5s

# Hardware and Sandbox Hardening
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sahakar-edge
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/sahakar-edge

[Install]
WantedBy=multi-user.target
