# ==========================================
# Sahakar Edge - Environment Configuration
# ==========================================

# Node Environment
NODE_ENV=development

# Central API Settings
PORT=4000
HOST=0.0.0.0
CENTRAL_API_URL=http://localhost:4000
DATABASE_URL=postgresql://sahakar_admin:sahakar_secure_password_dev_only@localhost:5432/sahakar_central
JWT_SECRET=super_secret_ncct_central_key_change_in_prod

# Ed25519 Credential Issuer Key (Optional in Dev - auto-generated if omitted)
# ISSUER_ED25519_PRIVATE_KEY=your_hex_private_key_here

# Edge Server Settings
EDGE_PORT=5000
EDGE_NODE_ID=edge-node-ricm-bhopal-01
EDGE_DB_PATH=./data/edge.sqlite
EDGE_SYNC_INTERVAL_SEC=30
WAN_SIMULATION_MODE=online # online | offline | flaky

# Web Admin Next.js URL
NEXT_PUBLIC_CENTRAL_API_URL=http://localhost:4000

# Trainee PWA URL
VITE_EDGE_SERVER_URL=http://localhost:5000
VITE_CENTRAL_API_URL=http://localhost:4000
