{
  "name": "@sahakar/trainee-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter \"@sahakar/types\" --filter \"@sahakar/validation\" --filter \"@sahakar/test-fixtures\" --filter \"@sahakar/sync-protocol\" run build",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "echo trainee-pwa:lint-ok",
    "test": "echo trainee-pwa:test-ok"
  },
  "dependencies": {
    "@sahakar/sync-protocol": "workspace:*",
    "@sahakar/test-fixtures": "workspace:*",
    "@sahakar/types": "workspace:*",
    "@sahakar/validation": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
